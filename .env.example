# .env.example — required environment variables for the SEO toolkit
#
# Copy this file to `.env` and populate with real values. `.env` is gitignored;
# never commit real credentials. Service-account JSON files go in `.secrets/`
# (also gitignored).
#
# Most skills work with no API keys configured — Claude Code does the heavy
# LLM lifting. The keys below unlock additional scripts and cron-fired routines.
#
# Sections:
#   1. Image sources (Pexels, Unsplash) — used by /blog skill
#   2. Google APIs (PageSpeed, Search Console)
#   3. Backlink / SERP tools (Ahrefs, SEMrush)
#   4. LLM API keys (OpenAI, Anthropic, Perplexity) — only if scripts call LLMs directly
#   5. Google Business Profile API — used by GBP-reviews cron
#   6. GA4 Data API — used by anomaly-detection cron

# --- 1. Image sources (used by scripts/fetch-images.mjs) ---
PEXELS_API_KEY=
UNSPLASH_API_KEY=

# --- 2. Google APIs (used by scripts/lighthouse.mjs and validate-schema.mjs) ---
# Get one free key from: https://console.cloud.google.com/apis/credentials
# Enable: PageSpeed Insights API, Safe Browsing API
GOOGLE_PAGESPEED_API_KEY=

# Google Search Console — legacy service-account auth (optional)
# Set up: https://developers.google.com/webmaster-tools/v1/how-tos/authorizing
GSC_SERVICE_ACCOUNT_EMAIL=
GSC_PRIVATE_KEY_PATH=./gsc-service-account-key.json

# Google Search Console — OAuth Desktop client (recommended)
# Used by cron routines via scripts/test-api-auth.mjs OAuth flow.
# Scope: webmasters.readonly.
GSC_OAUTH_CLIENT_ID=
GSC_OAUTH_CLIENT_SECRET=
GSC_OAUTH_REFRESH_TOKEN=

# --- 3. Ahrefs / SEMrush (optional — for deep /audit backlink analysis) ---
AHREFS_API_TOKEN=
SEMRUSH_API_KEY=

# --- 4. OpenAI / Anthropic / Perplexity (optional — only if scripts need direct LLM calls) ---
# Most LLM calls go through Claude Code, not these scripts
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Perplexity API — for AI-search-visibility cron routine
# Set to "scrape" to use a Chrome MCP scrape fallback instead of paid API.
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL=sonar

# --- 5. Google Business Profile API — for GBP-reviews cron routine ---
# Requires Google approval (24-72h via https://support.google.com/business/contact/api_default).
GBP_OAUTH_CLIENT_ID=
GBP_OAUTH_CLIENT_SECRET=
GBP_OAUTH_REFRESH_TOKEN=

# --- 6. GA4 Data API — for anomaly-detection cron routine ---
# Service account JSON; grant Viewer role on each site's GA4 property.
GA4_SERVICE_ACCOUNT_JSON_PATH=.secrets/ga4-service-account.json

# --- 7. Daily digest webhook (optional — Make.com / Zapier / n8n → email) ---
# Used by scripts/daily-digest.mjs to POST the 24h summary for email delivery.
CRUISE_CONTROL_WEBHOOK_URL=
